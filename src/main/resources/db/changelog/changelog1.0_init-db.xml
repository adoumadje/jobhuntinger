<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd
  http://www.liquibase.org/xml/ns/pro
  http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.8.xsd">

    <!-- ===================== -->
    <!--       USER TABLE      -->
    <!-- ===================== -->
    <changeSet id="1-create-user-entity" author="Caleb">
        <createTable tableName="user_entity">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="firstname" type="VARCHAR(255)"/>
            <column name="lastname" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="profile_picture_url" type="VARCHAR(500)"/>

            <column name="created_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <modifyDataType tableName="user_entity"
                        columnName="updated_at"
                        newDataType="TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
    </changeSet>

    <!-- ===================== -->
    <!--    DOCUMENT TABLE     -->
    <!-- ===================== -->
    <changeSet id="2-create-document" author="Caleb">
        <createTable tableName="document">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="document_name" type="VARCHAR(255)"/>
            <column name="document_type" type="VARCHAR(50)"/>
            <column name="document_url" type="VARCHAR(500)"/>
            <column name="google_drive_id" type="VARCHAR(255)"/>
            <column name="amazon_s3_key" type="VARCHAR(255)"/>

            <column name="created_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <modifyDataType tableName="document"
                        columnName="updated_at"
                        newDataType="TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
    </changeSet>

    <changeSet id="3-add-fk-document-user" author="Caleb">
        <addForeignKeyConstraint
                baseTableName="document"
                baseColumnNames="user_id"
                referencedTableName="user_entity"
                referencedColumnNames="id"
                constraintName="fk_document_user"/>
    </changeSet>


    <!-- ===================== -->
    <!--       JOB TABLE       -->
    <!-- ===================== -->
    <changeSet id="4-create-job" author="Caleb">
        <createTable tableName="job">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="job_public_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="company_name" type="VARCHAR(255)"/>
            <column name="company_logo_url" type="VARCHAR(500)"/>
            <column name="job_title" type="VARCHAR(255)"/>
            <column name="job_description_text" type="TEXT"/>
            <column name="job_description_document_url" type="VARCHAR(500)"/>
            <column name="resume_name" type="VARCHAR(255)"/>
            <column name="resume_url" type="VARCHAR(500)"/>

            <column name="created_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"
                    defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <modifyDataType tableName="document"
                        columnName="updated_at"
                        newDataType="TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
    </changeSet>

    <changeSet id="5-add-fk-job-user" author="Caleb">
        <addForeignKeyConstraint
                baseTableName="job"
                baseColumnNames="user_id"
                referencedTableName="user_entity"
                referencedColumnNames="id"
                constraintName="fk_job_user"/>
    </changeSet>



</databaseChangeLog>