<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:pro="http://www.liquibase.org/xml/ns/pro"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd
  http://www.liquibase.org/xml/ns/pro
  http://www.liquibase.org/xml/ns/pro/liquibase-pro-3.8.xsd">

    <!-- ===================== -->
    <!--    LOAD USER DATA     -->
    <!-- ===================== -->
    <changeSet id="6-load-user-data" author="Caleb">
        <loadData
                file="db/csv/user_entity.csv"
                tableName="user_entity"
                separator=","
                encoding="UTF-8"/>
    </changeSet>

    <!-- ===================== -->
    <!--     LOAD JOB DATA     -->
    <!-- ===================== -->
    <changeSet id="7-load-job-data" author="Caleb">
        <loadData
                file="db/csv/jobs.csv"
                tableName="job"
                separator=","
                encoding="UTF-8"/>
    </changeSet>

    <!-- ===================== -->
    <!--  LOAD DOCUMENT DATA   -->
    <!-- ===================== -->
    <changeSet id="8-load-document-data" author="Caleb">
        <loadData
                file="db/csv/document.csv"
                tableName="document"
                separator=","
                encoding="UTF-8"/>
    </changeSet>


</databaseChangeLog>